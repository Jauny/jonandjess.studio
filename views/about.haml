.container
  .about-page
    .heading.centered
      %h5 who we are 
      %h1 
        We are a group of creatives, developers and thinkers from the agency world and Silicon Valley.

    .what-we-do
      .thing
        .picture
          %img{:src => "static/Nest.svg"}
        .text 
          %h1 We treat your business like it's our own. 
          %p That means solving high-impact problems that may not always have shiny solutions.  Not everyone thinks that's fun. We do.

      .thing
        .picture
          %img{:src => "static/WebBrowser.svg"}
        .text 
          %h1 We design and build stuff on the web. 
          %p Among other things. We create inspiring customer experiences through brand, product, and marketing across the entire customer journey.

      .thing
        .picture
          %img{:src => "static/Glasses.svg"}
        .text 
          %h1 Not in business to be business people.
          %p Jon and Jess and everyone on our team are makers above all else. You won’t ever talk to an account person here, saving you time and money.

      .thing
        .picture
          %img{:src => "static/Tandem.svg"}
        .text 
          %h1 We help fast-growing companies run faster.
          %p Our founders met at the fastest growing company in history. We understand the challenges that come with rapid growth, brand building, and product iteration.

      .thing
        .picture
          %img{:src => "static/IceCream.svg"}
        .text 
          %h1
            Nice work.
            %br/
            Nice people.
          %p We combine the creative expertise of top agency talent with the business acumen and technical capabilities of Silicon Valley, minus the ego. 

.about-page
  .work-with-us
    .container
      .inner
        %h5 work with us 
        %h1 Want to build something together? We’d love to hear from you.
        %form{:action => "contact.html"}
          %button say hey

:javascript 
  const wih = window.innerHeight / 2
  const things = Array.from(document.getElementsByClassName('thing'))
  things.forEach(thing => {
    const left = thing.firstElementChild 
    const right = thing.lastElementChild
    scrollStrafing(left, -15, 0, wih)
    scrollStrafing(right, 15, 0, wih)
    window.addEventListener('scroll', () => {
      scrollStrafing(left, -15, 0, wih)
      scrollStrafing(right, 15, 0, wih)
    })
  })
