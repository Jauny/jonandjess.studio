.container
  .logo
    #logo-container
      %img{:src => "static/logo.png"}

  #scrollarrow-container
    .scrollarrow#scrollarrow

  .who
    %h5 who we are
    %h1
      We are a creative and engineering studio led by Jon and Jess. 
      We solve business problems through design, storytelling, and code.
    %h2
      Our founders met in 2014 while working on the Growth Team at Uber
      and have since teamed up to help other companies build their products, grow their brands,
      and inspire their customers.

  .us
    .one
      .shot.him
        .overlay
      %h1 Jon 
      %h5 Left brain
      %p 
        Jon was born in Paris and grew up in Montreal where he studied Finance.
        He hated it, so he moved to San Francisco to become an engineer.
        He spent over 4 years at Uber, building and scaling growth systems,
        enabling the company to onboard hundreds of thousands of drivers per week across hundreds of countries.
        When not writing code, you can find Jon playing League of Legends, supporting Paris Saint-Germain
        or cooking a mean coq au vin. Often all at the same time.
      .linkedin
        %a{:href => "https://www.linkedin.com/in/jypepin/", :target => "_blank"}
          %img{:src => "static/linkedin.svg"}

    .one
      .shot.her
        .overlay
      %h1 Jess 
      %h5 Right brain
      %p 
        Jess is a San Francisco native with a background in art direction, design and creative leadership. Prior to co-founding Jon&Jess, she helped build and lead Uber's creative team in Amsterdam and was a lead designer on Uber's Growth Team in San Francisco. Before joining Uber, she served as an art director at several ad agencies including CP+B and Evolution Bureau. Outside Jon&Jess, Jess is an enthusiastic dog mom, serial hobbyist and founder of the learn-for-leisure lecture series The Social Study.
      .linkedin
        %a{:href => "https://www.linkedin.com/in/jessica-wong-31753621/", :target => "_blank"}
          %img{:src => "static/linkedin.svg"}

.testimonials
  .carousel
    .container
      %h1 Jon&Jess has been an invaluable partner as Bird set out to launch and grow our EMEA market. They understand the value of speed, quality, and flexibility when it comes to working with hyper-growth companies.
      .name Jan De Wulf 
      .title Head of EMEA Brand, Bird
    .container
      %h1 When it comes to branding, design and web development projects for my clients, Jon and Jess Studio are consistently my collaborator of choice. I couldn't think of a team that better understands my needs, ambitions and aesthetic. They've become a true partner to me and my business. 
      .name Eva Baczynska 
      .title Founder, The Aster Group
  .dots
    .dot.active
    .dot

.container.container-contact
  = partial :contact

%script{:src => "static/js/siema.min.js"}
:javascript 
  // his and hers picture animation
  const hisPicture = document.getElementsByClassName('shot him')[0]
  const herPicture = document.getElementsByClassName('shot her')[0]
  const animatePictures = () => {
    const wih = window.innerHeight / 2

    const hisPos = hisPicture.getBoundingClientRect()
    const hisTop = hisPos.top
    const hisOverlay = hisPicture.children[0]

    const herPos = herPicture.getBoundingClientRect()
    const herTop = herPos.top
    const herOverlay = herPicture.children[0]

    hisOverlay.style.top = -Math.min(0, (hisTop - wih) * 0.7) + 'px'
    herOverlay.style.top = Math.min(0, (herTop - wih) * 0.7) + 'px'
  }

  // scrollarrow animation
  const arrow = document.getElementById('scrollarrow')
  const arrowFading = () => {
    const wih = window.innerHeight
    const arrowBottom = arrow.getBoundingClientRect().bottom
    if (wih - arrowBottom > 50) {
      arrow.style.opacity = 0
    } else if (wih - arrowBottom < 35) {
      arrow.style.opacity = 100
    }
  }
  const arrowAnimation = () => {
  }

  const wih = window.innerHeight
  // scroll scale the logo
  const logo = document.getElementById('logo-container')
  scrollScale(logo, 1, 0.8, wih)

  // scroll scale who we are
  const who = document.getElementsByClassName('who')[0]
  scrollScale(who, 0.2, wih, 'up')

  // contact appear
  const contactAnimation = () => {
    const contact = document.getElementsByClassName('contact')[0]
    const contactTop = contact.getBoundingClientRect().top
    if (window.innerHeight - contactTop > 100) {
      contact.style.transform = 'translateY(0)'
      contact.style.opacity = 100
    }
  }

  window.addEventListener('scroll', (e) => {
    if (window.innerWidht > 768) {
      // scroll straf him and her
      const him = document.getElementsByClassName('us')[0].firstElementChild
      const her = document.getElementsByClassName('us')[0].lastElementChild
      scrollStrafing(him, -30, 0, wih)
      scrollStrafing(her, 30, 0, wih)
    }
    scrollScale(logo, 1, 0.8, wih)
    scrollScale(who, 0.8, 1, wih)
    animatePictures()
    contactAnimation()
    arrowFading()
  })

  // carousel on testimonials
  const hightlightDots = (dots, activeIndex) => {
    for (let i = 0; i < dots.length; i++) {
      if (i === activeIndex) {
        dots[i].classList.add('active')
      } else {
        dots[i].classList.remove('active')
      }
    }
  }
  const carousel = document.querySelector('.carousel')
  const dots = document.querySelector('.dots').children
  const siema = new Siema({
    selector: carousel,
    loop: true,
    onChange: function() {
      hightlightDots(dots, this.currentSlide)
    }
  })
  // dots
  for (let i = 0; i < dots.length; i++) {
    dots[i].addEventListener('click', () => siema.goTo(i))
  }
