:javascript 
  document.getElementById('header-logo').style.visibility = 'hidden'

  const hisPicture = document.getElementsByClassName('shot him')[0]
  const herPicture = document.getElementsByClassName('shot her')[0]

  window.addEventListener('scroll', (e) => {
    const wih = window.innerHeight / 2
    const hisPos = hisPicture.getBoundingClientRect()
    const hisTop = hisPos.top
    const hisOverlay = hisPicture.children[0]

    const herPos = herPicture.getBoundingClientRect()
    const herTop = herPos.top
    const herOverlay = herPicture.children[0]

    hisOverlay.style.top = -Math.min(0, (hisTop - wih) * 0.7) + 'px'
    hisOverlay.style.transform = `rotate(${hisTop - wih}deg)`

    herOverlay.style.top = Math.min(0, (herTop - wih) * 0.7) + 'px'
  })