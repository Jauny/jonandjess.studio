%script{:src => "static/js/siema.min.js"}
:javascript 
  const wih = window.innerHeight
  const projects = Array.from(document.getElementsByClassName('project'))
  projects.forEach(project => {
    const text = project.querySelector('.description')
    appear(text, wih)
    window.addEventListener('scroll', () => {
      appear(text, wih)
    })

    const hightlightDots = (dots, activeIndex) => {
      for (let i = 0; i < dots.length; i++) {
        if (i === activeIndex) {
          dots[i].classList.add('active')
        } else {
          dots[i].classList.remove('active')
        }
      }
    }

    const carousel = project.querySelector('.carousel')
    if (carousel) {
      const left = project.querySelector('.left')
      const right = project.querySelector('.right')
      const dots = project.querySelector('.dots').children

      const siema = new Siema({
        selector: carousel,
        loop: true,
        onChange: function() {
          hightlightDots(dots, this.currentSlide)
        }
      })


      // left arrow
      left.addEventListener('click', () => siema.prev())

      // right arrow
      right.addEventListener('click', () => siema.next())

      // dots
      for (let i = 0; i < dots.length; i++) {
        dots[i].addEventListener('click', () => siema.goTo(i))
      }
    }
  })
