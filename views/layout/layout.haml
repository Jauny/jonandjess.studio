!!! 5
%html
  %head
    %meta{:charset => "UTF-8"}
    %meta{:name => "viewport", :content => "width=device-width", :initial-scale => "1"}

    %title Jon&Jess | A creative and engineering studio
    %meta{:name => "description", :content => "We solve business problems through design, storytelling, and code. Our founders met in 2014 while working on the Growth Team at Uber and have since teamed up to help other companies build their products, grow their brands, and inspire their customers."}

    %meta{:property => "og:title", :content => "Jon&Jess | A creative and engineering studio"}
    %meta{:property => "og:description", :content => "We solve business problems through design, storytelling, and code. Our founders met in 2014 while working on the Growth Team at Uber and have since teamed up to help other companies build their products, grow their brands, and inspire their customers."}
    %meta{:property => "og:image", :content => "http://www.jonandjess.studio/static/jon&jess.png"}

    %link{:rel => :stylesheet, :type => "text/css", :href => "static/styles/styles.css"}
    %link{:rel => :stylesheet, :type => "text/css", :href => "static/styles/nav.css"}
    %link{:rel => :stylesheet, :type => "text/css", :href => "static/styles/#{active}.css"}
    %link{:rel => :stylesheet, :type => "text/css", :href => "https://fonts.googleapis.com/css?family=Cormorant+Garamond:500,500i,600|Montserrat:500,700"}
    %script{:src => "static/js/scroll.js"}

    %script{:async => true, :src => "https://www.googletagmanager.com/gtag/js?id=UA-133943040-1"}
    %script
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'UA-133943040-1');

  %body
    .container
      = partial :nav, :active => active

    = yield

    .footer
      .container
        %ul 
          %li
            %a{:href => 'index.html'} home
          %li 
            %a{:href => 'about.html'} about
          %li 
            %a{:href => 'work.html'} work
          %li 
            %a{:href => 'contact.html'} contact

        %a{:href => 'index.html'}
          %img{:src => "static/logodot.svg"}
      .container.copywrite
        %p &copy; Spacebar BV
