!!! 5
%html
  %head
    %meta{:http-equiv => "content-type", :content => "text/html;charset=utf-8"}
    %link{:rel => :stylesheet, :type => "text/css", :href => "static/styles/styles.css"}
    %link{:rel => :stylesheet, :type => "text/css", :href => "static/styles/nav.css"}
    %link{:rel => :stylesheet, :type => "text/css", :href => "static/styles/#{active}.css"}
    %link{:rel => :stylesheet, :type => "text/css", :href => "https://fonts.googleapis.com/css?family=Cormorant+Garamond:500,500i,600|Montserrat:500,700"}
    %script{:src => "static/js/scroll.js"}
  %body
    .container
      = partial :nav, :active => active

    = yield

    .footer
      .container
        %ul 
          %li
            %a{:href => 'index.html'} home
          %li 
            %a{:href => 'about.html'} about
          %li 
            %a{:href => 'work.html'} work
          %li 
            %a{:href => 'contact.html'} contact

        %a{:href => 'index.html'}
          %img{:src => "static/logodot.svg"}
      .container.copywrite
        %p &copy; Spacebar BV
