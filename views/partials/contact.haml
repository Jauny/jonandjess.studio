.contact
  %h1 Say Hey
  %p 
    Want to make something together? Leave us a note below and we'll get back to you in a jiffy.
    Or send us an email at
    %span.red hello@jonandjess.studio.
  %form{:action => 'https://hooks.zapier.com/hooks/catch/3721141/0mhglf/', :onsubmit => "submitContact(event)"}
    %input{:type => 'text', :name => 'name', :autocomplete => 'nope'}
    %h5 name
    %input{:type => 'email', :name => 'email'}
    %h5 email
    %textarea{:name => 'message'}
    %h5 message
    %input{:type => 'hidden', :name => '_subject', :value => 'New contact from jonandjess.studio!'}
    %button{:type => 'submit'} Submit

:javascript 
  const submitContact = (e) => {
    console.log('hello', e)
    e.preventDefault();
    const xmlhttp = new XMLHttpRequest();   // new HttpRequest instance 
    xmlhttp.open("POST", e.target.action);
    const formData = new FormData(e.target)
    const data = {}
    formData.forEach((v, k) => data[k] = v)
    xmlhttp.send(JSON.stringify(data))
    e.target.style.opacity = 0

  }